// DO NOT MODIFY THIS FILE                                                                  //
// This file is automatically generated by ZenStack CLI and should not be manually updated. //
//////////////////////////////////////////////////////////////////////////////////////////////

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  COUNCIL_EDITOR
}

enum RunType {
  BLK
  GEN
  GAR
  REC
  ORG
}

enum ImportStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

model User {
  id        Int      @id() @default(autoincrement())
  email     String   @unique()
  password  String
  role      Role     @default(COUNCIL_EDITOR)
  councilId Int?     @map("council_id")
  council   Council? @relation(fields: [councilId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")

  @@map("users")
}

model Council {
  id             Int         @id() @default(autoincrement())
  name           String      @unique()
  slug           String      @unique()
  sitecoreSiteId String?     @unique() @map("sitecore_site_id")
  legacyWpSiteId Int?        @unique() @map("legacy_wp_site_id")
  addresses      Address[]
  importLogs     ImportLog[]
  users          User[]
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt() @map("updated_at")

  @@map("councils")
}

model Address {
  id           Int                  @id() @default(autoincrement())
  councilId    Int                  @map("council_id")
  council      Council              @relation(fields: [councilId], references: [id], onDelete: Cascade)
  customerId   String?              @map("customer_id")
  streetNumber Int?                 @map("street_number")
  unit         String?              @map("unit_string")
  street       String?
  suburb       String?
  postcode     String?
  schedules    CollectionSchedule[]
  createdAt    DateTime             @default(now()) @map("created")

  @@unique([councilId, customerId])
  @@index([councilId, suburb, street])
  @@map("addresses")
}

model CollectionSchedule {
  id               Int      @id() @default(autoincrement())
  addressId        Int      @map("address_id")
  address          Address  @relation(fields: [addressId], references: [id], onDelete: Cascade)
  runType          RunType  @map("runtype")
  dayOfWeek        Int      @default(1) @map("dayofweek")
  weekly           Boolean  @default(false)
  weekStart        Int      @default(1) @map("weekstart")
  originalRun      String?  @map("original_run")
  originalSequence String?  @map("original_sequence")
  originalSchedule String?  @map("original_schedule")
  createdAt        DateTime @default(now()) @map("created")

  @@index([addressId])
  @@index([runType])
  @@map("collection_schedules")
}

model ImportLog {
  id                Int          @id() @default(autoincrement())
  councilId         Int          @map("council_id")
  council           Council      @relation(fields: [councilId], references: [id], onDelete: Cascade)
  filename          String?
  blobUrl           String?      @map("blob_url")
  status            ImportStatus @default(PENDING)
  addressesImported Int?         @map("addresses_imported")
  addressErrors     Int?         @map("address_errors")
  summary           String?
  startedAt         DateTime?    @map("started")
  completedAt       DateTime?    @map("completed")

  @@index([councilId, startedAt])
  @@map("import_log")
}
